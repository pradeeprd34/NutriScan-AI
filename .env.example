# ==============================================================================
# NutriScan AI - Environment Configuration
# ==============================================================================
#
# 1. LIVE AI VISION INTEGRATION (OPTIONAL)
# You can connect Google Gemini Vision API to analyze real uploaded meals live.
# Get a free Gemini API Key from: https://aistudio.google.com/
#
# If left empty, NutriScan AI automatically operates in intelligent offline mode
# with its built-in visual classification engine and 50+ meal database!
#
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (defaults to gemini-1.5-flash)
VITE_AI_MODEL=gemini-1.5-flash

# Application Port
VITE_PORT=3000
